                                                        "term": {
                                                            "status": "confirmed"
                                                        }
                                                    }
                                                ]
                                            }
                                        },
                                        {
                                            "term": {
                                                "status": "seated"
                                            }
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                }
            }
        },
        "filter_post_filter_search": {
            "index": "bookings_parity",
            "body": {
                "_source": true,
                "query": {
                    "bool": {
                        "must": [
                            {
                                "multi_match": {
                                    "query": "birthday dinner",
                                    "type": "most_fields",
                                    "fields": [
                                        "guest_name^2",
                                        "notes^1"
                                    ],
                                    "fuzziness": "AUTO"
                                }
                            }
                        ],
                        "filter": {
                            "bool": {
                                "must": [
                                    {
                                        "terms": {
                                            "status": [
                                                "confirmed",
                                                "seated"
                                            ]
                                        }
                                    }
                                ]
                            }
                        }
                    }
                },
                "post_filter": {
                    "bool": {
                        "must": [
                            {
                                "term": {
                                    "venue_id": 17
                                }
                            }
                        ]
                    }
                }
            }
        },
        "nested_relationships_and_types": {
            "index": "bookings_parity",
            "body": {
                "_source": true,
                "query": {
                    "bool": {
                        "must": [
