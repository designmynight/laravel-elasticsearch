{
    "queries": {
        "where_operators": {
            "index": "bookings_parity",
            "body": {
                "_source": true,
                "query": {
                    "bool": {
                        "must": [
                            {
                                "term": {
                                    "status": "confirmed"
                                }
                            },
                            {
                                "bool": {
                                    "must_not": [
                                        {
                                            "term": {
                                                "covers": 2
                                            }
                                        }
                                    ]
                                }
                            },
                            {
                                "range": {
                                    "covers": {
                                        "lt": 8
                                    }
                                }
                            },
                            {
                                "range": {
                                    "covers": {
                                        "gt": 1
                                    }
                                }
                            },
                            {
                                "range": {
                                    "covers": {
                                        "lte": 6
                                    }
                                }
                            },
                            {
                                "range": {
                                    "covers": {
                                        "gte": 2
                                    }
                                }
                            },
                            {
                                "term": {
                                    "guest_name": "like"
                                }
                            }
                        ]
                    }
                }
            }
        },
        "where_in_null_between_date": {
            "index": "bookings_parity",
            "body": {
                "_source": true,
                "query": {
                    "bool": {
                        "must": [
                            {
                                "terms": {
                                    "status": [
                                        "confirmed",
                                        "seated"
                                    ]
                                }
                            },
                            {
                                "bool": {
                                    "must_not": [
                                        {
                                            "terms": {
                                                "status": [
                                                    "cancelled"
                                                ]
                                            }
                                        }
                                    ]
                                }
                            },
                            {
                                "bool": {
                                    "must_not": [
                                        {
                                            "exists": {
                                                "field": "deleted_at"
                                            }
                                        }
                                    ]
                                }
                            },
                            {
                                "bool": {
                                    "must_not": [
                                        {
                                            "exists": {
                                                "field": "guest_name"
                                            }
                                        }
                                    ]
                                }
                            },
                            {
                                "range": {
                                    "covers": {
                                        "gte": 2,
                                        "lte": 8
                                    }
                                }
                            },
                            {
                                "range": {
                                    "created_at": {
                                        "gte": "2020-01-01T00:00:00",
                                        "lte": "2020-01-31T23:59:59"
                                    }
                                }
                            },
                            {
                                "range": {
                                    "created_at": {
                                        "gte": "2020-01-15",
                                        "lte": "2020-01-15"
                                    }
                                }
                            }
                        ]
                    }
                }
            }
        },
        "nested_and_or": {
            "index": "bookings_parity",
            "body": {
                "_source": true,
                "query": {
                    "bool": {
                        "must": [
                            {
                                "bool": {
                                    "should": [
                                        {
                                            "bool": {
                                                "must": [
