        "sort_pagination_function_score_geo_script": {
            "index": "bookings_parity",
            "body": {
                "_source": true,
                "query": {
                    "bool": {
                        "must": [
                            {
                                "function_score": {
                                    "field_value_factor": {
                                        "field_value_factor": {
                                            "field": "popularity"
                                        }
                                    }
                                }
                            },
                            {
                                "geo_distance": {
                                    "distance": "1km",
                                    "location": {
                                        "lat": 51.5,
                                        "lon": -0.12
                                    }
                                }
                            },
                            {
                                "script": {
                                    "script": {
                                        "params": {
                                            "limit": 2
                                        },
                                        "source": "doc['covers'].value > params.limit"
                                    }
                                }
                            }
                        ]
                    }
                },
                "sort": [
                    {
                        "created_at": {
                            "missing": "_last",
                            "mode": "max",
                            "order": "desc"
                        }
                    },
                    {
                        "_geo_distance": {
                            "location": {
                                "lat": 51.5,
                                "lon": -0.12
                            },
                            "order": "asc",
                            "unit": "km",
                            "distance_type": "plane"
                        }
                    }
                ],
                "from": 50,
                "size": 25
            }
        },
